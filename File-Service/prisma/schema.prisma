generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Folder {
  f_id         Int   @id @default(autoincrement())
  title        String
  description  String?
  organization String
  color        String
  createdAt    DateTime @default(now())
}
